{
  "name": "laceyskin",
  "main": "worker/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/login", "/catalog", "/settings", "/code", "/visit", "/stats",
      "/order", "/order/*", "/orders", "/status", "/track",
      "/customers", "/customer", "/discount", "/discounts",
      "/auth/*", "/chat/*", "/adm/*", "/media", "/media/*", "/manifest.json", "/quote", "/codes", "/me", "/me/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lacey-store"
    }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
